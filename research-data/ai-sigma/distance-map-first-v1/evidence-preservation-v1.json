      "argv": [
        "sudo",
        "-n",
        "python3",
        "-B",
        "-c",
        "\nimport json, os, sys\nfrom pathlib import Path\nresult=[]\nfor pid in json.loads(sys.argv[1]):\n    p=Path('/proc')/str(pid)\n    try:\n        comm=(p/'comm').read_text().strip()\n        args=[s.decode(errors='replace') for s in (p/'cmdline').read_bytes().split(b'\\0') if s]\n        exe=os.readlink(p/'exe')\n        refs=[exe,os.readlink(p/'cwd')]\n        for fd in (p/'fd').iterdir():\n            try: refs.append(os.readlink(fd))\n            except (FileNotFoundError,ProcessLookupError): pass\n        entry=''\n        if comm.startswith('python'):\n            pos=1\n            while pos<len(args) and args[pos] in ('-B','-I','-u','-E','-s','-S'): pos+=1\n            if pos<len(args): entry=args[pos]\n        named=comm in ('cargo','rustc','clippy-driver','perf','chrome','chromium','firefox','headless_shell')\n        numeric=any(s in Path(entry).name for s in ('worker','numeric','analysis_ci','statistics','finite-driver','generate_dataset','qualification'))\n        payload='/workspaces/quoridor' in exe and any(s in exe for s in ('/private/','/target/'))\n        target=sys.argv[2]\n        result.append({'pid':pid,'WT_reference':any(s==target or s.startswith(target+'/') for s in refs),'competitor':named or numeric or payload})\n    except (FileNotFoundError,ProcessLookupError): result.append({'pid':pid,'absent':True})\nprint(json.dumps(result))\n",
