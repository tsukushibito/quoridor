190:     pub fn history_counts(&self) -> Vec<(HistoryKey, u16)> {
191:         let mut m: BTreeMap<_, _> = self.base.iter().copied().collect();
192:         for &k in &self.overlay {
193:             *m.entry(k).or_default() += 1;
194:         }
195:         m.into_iter().collect()
196:     }
197:     /// Reference raw mask can be nonempty after goal/ply-200. Never use it to expand a terminal.
198:     pub fn raw_legal_ids(&self) -> Vec<u16> {
199:         let geometric = Position {
200:             winner: None,
201:             ..self.position
202:         };
203:         geometric
204:             .legal_action_ids()
205:             .into_iter()
206:             .filter(|&id| {
207:                 id >= 81
208:                     || self.count(HistoryKey::from(
209:                         geometric.play(id).expect("geometric legal action"),
210:                     )) < 2
211:             })
212:             .collect()
213:     }
214:     pub fn terminal_value(&self) -> Option<f32> {
215:         if let Some(w) = self.position.winner {
216:             return Some(if w == self.position.turn { 1.0 } else { -1.0 });
217:         }
218:         if self.total_ply >= 200 || self.raw_legal_ids().is_empty() {
219:             return Some(0.0);
220:         }
221:         None
222:     }
223:     pub fn legal_ids(&self) -> Vec<u16> {
224:         if self.position.winner.is_some() || self.total_ply >= 200 {
225:             Vec::new()
226:         } else {
227:             self.raw_legal_ids()
228:         }
229:     }
230:     pub fn play(&self, id: u16) -> Result<Self, RulesError> {
231:         if self.terminal_value().is_some() {
232:             return Err(RulesError::GameOver);
233:         }
234:         if !self.legal_ids().contains(&id) {
235:             return Err(RulesError::IllegalAction);
236:         }
237:         let p = self.position.play(id)?;
238:         let mut c = self.clone();
239:         c.position = p;
240:         c.total_ply += 1;
241:         c.overlay.push(p.into());
242:         Ok(c)
243:     }
244:     /// Raw reference next() after terminal is diagnostic evidence, never a search input.
245:     #[cfg(feature = "research-diagnostics")]
246:     pub fn raw_next_diagnostic(&self, id: u16) -> Result<Self, RulesError> {
247:         if !self.raw_legal_ids().contains(&id) {
248:             return Err(RulesError::IllegalAction);
249:         }
250:         let mut p = Position {
251:             winner: None,
252:             ..self.position
253:         }
254:         .play(id)?;
255:         p.winner = if p.pawns[0] / 9 == 8 {
256:             Some(0)
257:         } else if p.pawns[1] / 9 == 0 {
258:             Some(1)
259:         } else {
260:             None
261:         };
262:         let mut c = self.clone();
263:         c.position = p;
264:         c.total_ply += 1;
265:         c.overlay.push(p.into());
266:         c.synthetic = true;
267:         Ok(c)

