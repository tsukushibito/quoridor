1: use quoridor_core::{research::{SigmaContext,HistoryKey,DIRECTIONS,sigma_to_rust},Position};
2: use serde_json::Value;
3: fn n(v: &Value) -> Result<u16, String> {
4:     v.as_u64()
5:         .and_then(|x| u16::try_from(x).ok())
6:         .ok_or("INPUT_INTEGER".into())
7: }
8: fn array(v: &Value) -> Result<&Vec<Value>, String> {
9:     v.as_array().ok_or("INPUT_ARRAY".into())
10: }
11: fn prefix_action(p: Position, a: &Value) -> Result<u16, String> {
12:     if a["type"] == "pawn" {
13:         let dx = a["direction"][0].as_i64().ok_or("DIRECTION")?;
14:         let dy = a["direction"][1].as_i64().ok_or("DIRECTION")?;
15:         let s = DIRECTIONS
16:             .iter()
17:             .position(|&(x, y)| i64::from(x) == dx && i64::from(y) == dy)
18:             .ok_or("DIRECTION")?;
19:         sigma_to_rust(p, s as u16).ok_or("DIRECTION".into())
20:     } else {
21:         let base = match a["orientation"].as_str() {
22:             Some("h") => 81,
23:             Some("v") => 145,
24:             _ => return Err("WALL_ORIENTATION".into()),
25:         };
26:         let x = n(&a["x"])?;
27:         let y = n(&a["y"])?;
28:         if x >= 8 || y >= 8 {
29:             return Err("WALL_ANCHOR".into());
30:         }
31:         Ok(base + 8 * y + x)
32:     }
33: }
34: pub fn context(f: &Value, diagnostic: bool) -> Result<SigmaContext, String> {
35:     if let Some(prefix) = f.get("prefix") {
36:         let ids = array(prefix)?
37:             .iter()
38:             .map(n)
39:             .collect::<Result<Vec<_>, _>>()?;
40:         return SigmaContext::from_prefix(&ids).map_err(|e| e.to_string());
41:     }
42:     let mut c = SigmaContext::from_prefix(&[]).map_err(|e| e.to_string())?;
43:     let mut ids = Vec::new();
44:     for a in array(&f["legal_prefix"])? {
45:         let id = prefix_action(c.position(), a)?;
46:         ids.push(id);
47:         c = c.play(id).map_err(|e| e.to_string())?
48:     }
49:     c = SigmaContext::from_prefix(&ids).map_err(|e| e.to_string())?;
50:     if f["classification"] == "legal-replay" {
51:         return Ok(c);
52:     }
53:     if !diagnostic {
54:         return Err("SYNTHETIC_DIAGNOSTIC_ONLY".into());
55:     }
56:     let b = &f["board"];
57:     let mut p = Position {
58:         pawns: [
59:             u8::try_from(n(&b["rust_pawns"][0])?).map_err(|_| "CELL")?,
60:             u8::try_from(n(&b["rust_pawns"][1])?).map_err(|_| "CELL")?,
61:         ],
62:         walls_remaining: [
63:             u8::try_from(n(&b["walls_remaining"][0])?).map_err(|_| "WALLS")?,
64:             u8::try_from(n(&b["walls_remaining"][1])?).map_err(|_| "WALLS")?,
65:         ],
66:         turn: u8::try_from(n(&b["turn"])?).map_err(|_| "TURN")?,
67:         horizontal: 0,
68:         vertical: 0,
69:         winner: None,
70:     };
71:     for (key, bits) in [
72:         ("rust_h_anchors", &mut p.horizontal),
73:         ("rust_v_anchors", &mut p.vertical),
74:     ] {
75:         for a in array(&b[key])? {
76:             let a = n(a)?;
77:             if a >= 64 {
78:                 return Err("ANCHOR".into());
79:             }
80:             *bits |= 1u64 << a
81:         }
82:     }
83:     p.winner = if p.pawns[0] / 9 == 8 {
84:         Some(0)
85:     } else if p.pawns[1] / 9 == 0 {
86:         Some(1)
87:     } else {
88:         None
89:     };
90:     let mut h = Vec::new();
91:     for a in array(&f["history_counts"])? {
92:         h.push((
93:             HistoryKey::parse(a[0].as_str().ok_or("HISTORY_KEY")?).map_err(|e| e.to_string())?,
94:             n(&a[1])?,
95:         ))
96:     }
97:     SigmaContext::synthetic_diagnostic(p, n(&b["total_ply"])?, h).map_err(|e| e.to_string())
98: }

