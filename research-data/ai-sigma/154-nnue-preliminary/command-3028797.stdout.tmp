160:     /// Shortest wall-only route to the player's goal. Pawns do not obstruct this graph.
161:     pub fn wall_distance(self, player: usize) -> Option<u8> {
162:         #[cfg(feature = "profiling")]
163:         let _span = crate::profiling::span(crate::profiling::Kind::Distance);
164:         if player > 1 || self.pawns[player] >= 81 {
165:             return None;
166:         }
167:         let mut seen = [false; 81];
168:         let mut queue = VecDeque::with_capacity(81);
169:         let start = self.pawns[player];
170:         seen[start as usize] = true;
171:         queue.push_back((start, 0u8));
172:         while let Some((cell, distance)) = queue.pop_front() {
173:             if cell / 9 == if player == 0 { 8 } else { 0 } {
174:                 return Some(distance);
175:             }
176:             for next in neighbors(cell).into_iter().flatten() {
177:                 if !seen[next as usize] && self.is_edge_open(cell, next) {
178:                     seen[next as usize] = true;
179:                     queue.push_back((next, distance + 1));
180:                 }
181:             }
182:         }
183:         None
184:     }
