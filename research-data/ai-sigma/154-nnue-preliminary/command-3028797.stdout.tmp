1: use crate::{Position, RULESET_ID, RulesError};
2: 
3: /// Storage/transport bound; ordinary play has no automatic ply-limit draw.
4: pub const MAX_REPLAY_ACTIONS: usize = 4096;
5: 
6: #[derive(Debug, Clone, PartialEq, Eq)]
7: pub struct GameView {
8:     pub ruleset_id: &'static str,
9:     pub pawns: [u8; 2],
10:     pub walls_remaining: [u8; 2],
11:     pub horizontal_walls: Vec<u8>,
12:     pub vertical_walls: Vec<u8>,
13:     pub turn: u8,
14:     pub winner: Option<u8>,
15:     pub ply: u32,
16:     pub legal_mask: Vec<u8>,
17:     pub position_key: String,
18: }
19: 
20: #[derive(Debug, Clone)]
21: pub struct Game {
22:     origin: Position,
23:     position: Position,
24:     history: Vec<u16>,
25:     cached_view: Option<GameView>,
26: }
27: impl Default for Game {
28:     fn default() -> Self {
29:         Self::new()
30:     }
31: }
32: impl Game {
33:     pub fn new() -> Self {
34:         let origin = Position::default();
35:         Self {
36:             origin,
37:             position: origin,
38:             history: Vec::new(),
39:             cached_view: None,
40:         }
41:     }
42:     /// Native fixture/search root. History and ply are relative to this position;
43:     /// standard replay/snapshot exports require the standard opening origin.
44:     pub fn from_position(position: Position) -> Result<Self, RulesError> {
45:         let origin = position.checked()?;
46:         Ok(Self {
47:             origin,
48:             position: origin,
49:             history: Vec::new(),
50:             cached_view: None,
51:         })
52:     }
53:     pub const fn position(&self) -> Position {
54:         self.position
55:     }
56:     /// Standard wire saves include actions from the standard opening only.
57:     pub fn has_standard_origin(&self) -> bool {
58:         self.origin == Position::default()
59:     }
60:     pub fn history(&self) -> &[u16] {
61:         &self.history
62:     }
63:     pub fn view(&mut self) -> GameView {
64:         if let Some(view) = &self.cached_view {
65:             return view.clone();
66:         }
67:         let position = self.position;
68:         let mut legal_mask = vec![0; 209];
69:         for id in position.legal_action_ids() {
70:             legal_mask[id as usize] = 1;
71:         }
72:         let view = GameView {
73:             ruleset_id: RULESET_ID,
74:             pawns: position.pawns,
75:             walls_remaining: position.walls_remaining,
76:             horizontal_walls: (0..64).filter(|&a| position.has_h(a)).collect(),
77:             vertical_walls: (0..64).filter(|&a| position.has_v(a)).collect(),
78:             turn: position.turn,
79:             winner: position.winner,
80:             ply: self.history.len() as u32,
81:             legal_mask,
82:             position_key: position.position_key(),
83:         };
84:         self.cached_view = Some(view.clone());
85:         view
86:     }
87:     pub fn apply_action(&mut self, id: u16) -> Result<GameView, RulesError> {
88:         self.position = self.position.play(id)?;
89:         self.history.push(id);
90:         self.cached_view = None;
91:         Ok(self.view())
92:     }
93:     pub fn undo_to_ply(&mut self, ply: usize) -> Result<GameView, RulesError> {
94:         if ply > self.history.len() {
95:             return Err(RulesError::InvalidUndo);
96:         }
97:         if ply == self.history.len() {
98:             return Ok(self.view());
99:         }
100:         let actions = self.history[..ply].to_vec();
101:         let mut replacement = Self::from_origin_actions(self.origin, &actions)?;
102:         let view = replacement.view();
103:         *self = replacement;
104:         Ok(view)
105:     }
106:     pub fn from_actions(actions: &[u16]) -> Result<Self, RulesError> {
107:         Self::from_origin_actions(Position::default(), actions)
108:     }
109:     fn from_origin_actions(origin: Position, actions: &[u16]) -> Result<Self, RulesError> {
110:         let mut game = Self::from_position(origin)?;
111:         for &action in actions {
112:             game.apply_action(action)?;
113:         }
114:         Ok(game)
115:     }

