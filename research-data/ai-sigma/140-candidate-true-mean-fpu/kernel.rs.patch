+/// NN0 artificial fixtures through the actual private backup/select/async paths.
+/// This does not imply that these terminal/cap branches occurred in the real inputs.
+pub fn mean_probe() -> serde_json::Value {
+    let mut cases=Vec::new();
+    for depth in 1..=4 {
+        let root=SigmaContext::from_prefix(&[]).unwrap();
+        let mut s=SearchSession::new_sigma(root.clone(),SearchLimits{simulations:32,max_nodes:32,max_depth:24},1979,B0Evaluator).unwrap();
+        let actions=[13,67,22,58];let mut ctx=root;let mut path=Vec::new();
+        for i in 0..depth {
+            let a=actions[i];let next=ctx.play(a).unwrap();
+            s.nodes[i].edges.push(Edge{action:a,prior:1.,child:Some(i+1),visits:0,value_sum:0.});
+            s.nodes.push(Node::new(next.position()));path.push((i,0));ctx=next;
+        }
+        PendingSearch::backup(&mut s,depth,path,true,0.375,&Some(ctx));
+        for i in 0..=depth {let expected=if (depth-i)%2==0 {0.375}else{-0.375};assert_eq!(s.nodes[i].visits,1);assert_eq!(s.nodes[i].true_value_sum,expected);}
+        cases.push(serde_json::json!({"case":"ancestor_depth","depth":depth,"visits":s.visit_trace}));
+    }
+    let lim=SearchLimits{simulations:8,max_nodes:1,max_depth:24};
+    let mut a=PendingSearch::new(SigmaContext::from_prefix(&[]).unwrap(),lim,1979,1).unwrap();
+    let q=a.begin(1).unwrap().unwrap();assert_eq!(a.search.nodes[0].visits,0);
+    a.resume(1,q.token,Evaluation{weights:vec![1.;q.legal.len()],value:0.25}).unwrap();
+    assert_eq!(a.search.nodes[0].true_value_sum,0.25);assert_eq!(a.search.nodes[0].visits,1);
+    let q=a.begin(1).unwrap().unwrap();a.resume(1,q.token,Evaluation{weights:vec![1.;q.legal.len()],value:0.25}).unwrap();
+    assert_eq!(a.search.nodes.len(),1);assert_eq!(a.search.nodes[0].visits,2);assert_eq!(a.search.nodes[0].true_value_sum,0.);
+    cases.push(serde_json::json!({"case":"async_root_and_cap_pseudo_leaf","visits":a.search.visit_trace,"actual_nodes":a.search.nodes.len()}));
+    let before=a.search.nodes[0].true_value_sum;assert!(a.resume(1,q.token,Evaluation{weights:vec![1.;q.legal.len()],value:0.25}).is_err());assert_eq!(a.search.nodes[0].true_value_sum,before);
+    cases.push(serde_json::json!({"case":"duplicate_async_discard","double_backup":false}));
+    let p=Position{pawns:[4,13],turn:1,..Position::default()};
+    for max_nodes in [1,8] {
+        let context=SigmaContext::synthetic_diagnostic(p,199,vec![(p.into(),1)]).unwrap();
+        let mut a=PendingSearch::new(context,SearchLimits{simulations:2,max_nodes,max_depth:24},1979,1).unwrap();
+        let q=a.begin(1).unwrap().unwrap();let weights=q.legal.iter().map(|&id|if id==3 {1.}else{0.}).collect();
+        a.resume(1,q.token,Evaluation{weights,value:0.25}).unwrap();assert!(a.begin(1).unwrap().is_none());
+        assert_eq!(a.calls,1);assert_eq!(a.search.nodes[0].visits,2);assert_eq!(a.search.nodes[0].true_value_sum,1.25);
+        if max_nodes>1 {assert_eq!(a.search.nodes[1].true_value_sum,-1.);assert_eq!(a.search.nodes[1].visits,1);}
+        cases.push(serde_json::json!({"case":"terminal_noNN_actual_or_pseudo","max_nodes":max_nodes,"calls":a.calls,"visits":a.search.visit_trace}));
+    }
+    let mut a=PendingSearch::new(SigmaContext::from_prefix(&[]).unwrap(),SearchLimits{simulations:4,max_nodes:32,max_depth:1},1979,1).unwrap();
+    for _ in 0..4 {if let Some(q)=a.begin(1).unwrap(){a.resume(1,q.token,Evaluation{weights:vec![1.;q.legal.len()],value:0.25}).unwrap();}}
+    assert!(a.search.visit_trace.iter().all(|v|v["postN"].as_u64()==v["preN"].as_u64().map(|n|n+1)));
+    cases.push(serde_json::json!({"case":"depth_cap_async","visits":a.search.visit_trace}));
+    let mut s=SearchSession::b0(Position::default(),SearchLimits{simulations:4,max_nodes:8,max_depth:4},1979).unwrap();
+    s.nodes[0].edges.push(Edge{action:13,prior:1.,child:None,visits:0,value_sum:0.});s.nodes[0].expanded=true;s.select(0);
+    assert!(s.select_trace[0]["true_mean"].is_null());assert!(s.select_trace[0]["fpu"].is_null());assert_eq!(s.select_trace[0]["actual_q"],0.);
+    cases.push(serde_json::json!({"case":"artificial_expanded_N0","selection":s.select_trace}));
+    let mut s=SearchSession::b0(Position::default(),SearchLimits{simulations:4,max_nodes:8,max_depth:4},1979).unwrap();s.step(4);
+    assert_eq!(s.nodes[0].visits,4);assert_eq!(s.visit_trace.iter().filter(|v|v["node_index"]==0).count(),4);
+    cases.push(serde_json::json!({"case":"sync_same_visit_helper","rootN":s.nodes[0].visits}));
+    serde_json::json!({"ok":true,"artificial_NN0":true,"real_browser_terminal_observed":false,"cases":cases,"FPU_enabled":cfg!(feature="true-mean-fpu")})
+}
