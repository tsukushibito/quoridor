+}
+/// A player/game owns this bounded table across its real move sequence.
+/// New games explicitly reset or create a session; namespace switches clear all entries.
+pub struct SearchSession {
+    namespace: SearchNamespace,
+    table: Table,
+}
+impl SearchSession {
+    pub fn new(namespace: SearchNamespace, capacity: usize) -> Result<Self> {
+        Ok(Self {
+            namespace,
+            table: Table::new(capacity)?,
+        })
+    }
+    pub fn reset(&mut self, namespace: SearchNamespace) {
+        self.namespace = namespace;
+        self.table.clear();
+    }
+    pub fn search(
+        &mut self,
+        root: &SigmaContext,
+        evaluator: &dyn StaticEvaluator,
+        namespace: &SearchNamespace,
+        limits: &SearchLimits,
+        cancel: &AtomicBool,
+    ) -> Result<SearchResult> {
+        if &self.namespace != namespace {
+            self.reset(namespace.clone());
+        }
+        search_in_table(
+            root,
+            evaluator,
+            limits,
+            cancel,
+            None,
+            &mut |_| {},
+            &mut self.table,
+        )
+    }
+}
