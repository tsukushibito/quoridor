{
  "name": "Quoridor Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "UV_IMAGE": "ghcr.io/astral-sh/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424",
      "INSTALL_GITHUB_CLI": "true",
      "INSTALL_GIT_LFS": "true",
      "INSTALL_IMAGE_TOOLS": "true",
      "INSTALL_SSH": "true",
      "INSTALL_VSCODE_CLI": "true",
      "INSTALL_CHATGPT_BROWSER": "false",
      "VSCODE_AMD64_URL": "https://packages.microsoft.com/repos/code/pool/main/c/code/code_1.139.1-1790309529_amd64.deb",
      "VSCODE_AMD64_SHA256": "cc8e35cf69ff4c7e515e19fa981bf6aba41f61ddb61c79370e9fe460c5dbaf8b",
      "VSCODE_ARM64_URL": "https://packages.microsoft.com/repos/code/pool/main/c/code/code_1.139.1-1790309508_arm64.deb",
      "VSCODE_ARM64_SHA256": "53cdf61fd870ec9663ea7baa5e4f79014acafc36d8c45b2678a8ce80d72d737d"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "minimal",
      "targets": "wasm32-unknown-unknown",
      "components": "rustfmt,clippy,rust-analyzer,rust-src"
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "init": true,
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "gpu": true
  },
  "containerEnv": {
    "CODEX_HOME": "/home/vscode/.codex",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
    "ORT_DISABLE_TELEMETRY": "1",
    "INFERENCE_CACHE_DIR": "/home/vscode/.cache/inference",
    "HF_HUB_CACHE": "/home/vscode/.cache/inference/huggingface/hub",
    "HF_XET_CACHE": "/home/vscode/.cache/inference/huggingface/xet",
    "HF_ASSETS_CACHE": "/home/vscode/.cache/inference/huggingface/assets",
    "TORCH_HOME": "/home/vscode/.cache/inference/torch",
    "WASM_PACK_CACHE": "/usr/local/cargo/wasm-pack-cache"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-codex,target=/home/vscode/.codex,type=volume",
    "source=${localWorkspaceFolderBasename}-worktrees,target=/workspaces/${localWorkspaceFolderBasename}/.worktree,type=volume",
    "source=${localWorkspaceFolderBasename}-inference-cache,target=/home/vscode/.cache/inference,type=volume",
    "source=${localWorkspaceFolderBasename}-gh,target=/home/vscode/.config/gh,type=volume",
    "source=${localWorkspaceFolderBasename}-vscode-data,target=/home/vscode/.vscode-data,type=volume",
    "source=${localWorkspaceFolderBasename}-ssh,target=/home/vscode/.ssh,type=volume"
  ],
  "forwardPorts": [],
  "portsAttributes": {},
  "runArgs": ["--gpus=all", "--network=host"],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-sshd.sh",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"]
    }
  }
}
